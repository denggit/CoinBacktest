      {"id": "eth_ohlcv_sqlite", "label": "Local OKX ETH-USDT-SWAP 1m OHLCV", "path": "data/crypto_history.db", "query": {"engine": "sqlite", "language": "sql", "description": "Closed local 1m candles causally aggregated to daily, 4H, and 15m.", "sql": "SELECT timestamp, open, high, low, close, volume FROM ETH_USDT_SWAP_1m WHERE timestamp >= '2020-01-01 00:00:00' AND timestamp <= '2026-08-15 23:59:59' ORDER BY timestamp", "tables_used": ["ETH_USDT_SWAP_1m"], "filters": ["Evaluation starts 2022-01-01", "2020-2021 is warmup only", "No missing evaluation minutes"], "metric_definitions": ["Flat day means every 15m interval in the natural day has zero gross exposure", "Losing day means compounded account return for the natural day is below zero", "Signals use completed candles and execute next 15m open or later", "Opening and closing each cost 0.05% of changed sleeve notional"]}}
